{
    "name": "kematjaya/chart-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "doctrine/collections": "^1.6|^2.0",
        "doctrine/orm": "^2.10|^3.0",
        "symfony/asset": "^6.4",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/security-core": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\ChartBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\ChartBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/framework-bundle": "^6.4"
    },
    "suggest": {
        "kematjaya/user-bundle": "^6.4, chart per role memakai DefaultUser::getSingleRole()"
    }
}
